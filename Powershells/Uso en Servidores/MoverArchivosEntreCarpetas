# ==================== CONFIGURACIÓN ====================
$extension = ".7z"  # Cambia la extensión según lo necesites
$origen    = "X:\xxxx\xx\xxxx" # Carpeta origen de datos a mover
$destino   = "\\xxxx\x$\xxxxxxxx" # Carpeta de destino de archivos Puede ser dentro del server u otro servidor
$logPath   = "C:\Logs\movimiento_robocopy_$(Get-Date -Format 'yyyyMMdd_HHmmss').log"
$statsPath = "C:\Logs\resumen_$(Get-Date -Format 'yyyyMMdd_HHmmss').log"
# =======================================================

# Crear carpeta de logs si no existe
$logDir = Split-Path $logPath
if (!(Test-Path $logDir)) {
    New-Item -Path $logDir -ItemType Directory -Force | Out-Null
}

# Verificar carpetas
if (!(Test-Path $origen)) {
    Write-Host "❌ Carpeta de origen no encontrada: $origen" -ForegroundColor Red
    exit
} else {
    Write-Host "`n📁 Ruta analizada: $origen" -ForegroundColor Cyan
}

if (!(Test-Path $destino)) {
    Write-Host "⚠ Carpeta de destino no encontrada. Intentando crear: $destino" -ForegroundColor Yellow
    try {
        New-Item -ItemType Directory -Path $destino -Force | Out-Null
        Write-Host "✅ Carpeta de destino creada correctamente." -ForegroundColor Green
    } catch {
        Write-Host "❌ No se pudo crear la carpeta de destino: $_" -ForegroundColor Red
        exit
    }
} else {
    Write-Host "📦 Carpeta destino: $destino" -ForegroundColor Cyan
}

# Analizar archivos
$archivos = Get-ChildItem -Path $origen -Recurse -File -Filter "*$extension" -ErrorAction SilentlyContinue
$cantidad = $archivos.Count
$tamanoTotalGB = [math]::Round(($archivos | Measure-Object Length -Sum).Sum / 1GB, 2)

# Mostrar resumen
Write-Host "📄 Extensión: $extension" -ForegroundColor Cyan
Write-Host "📦 Archivos detectados: $cantidad" -ForegroundColor Cyan
Write-Host "💾 Tamaño total: $tamanoTotalGB GB" -ForegroundColor Cyan
Write-Host "========================================================="

# Guardar log resumen
$resumen = @"
📂 Ruta analizada: $origen
📁 Carpeta destino: $destino
📄 Extensión: $extension
📦 Archivos detectados: $cantidad
💾 Tamaño total: $tamanoTotalGB GB
Fecha: $(Get-Date -Format "yyyy-MM-dd HH:mm:ss")
=========================================================
"@
Add-Content -Path $statsPath -Value $resumen

# -------- ROBOT COPY MOVIMIENTO --------
Write-Host "`n📦 Iniciando movimiento con Robocopy..." -ForegroundColor Yellow

$robocopyCmd = "robocopy `"$origen`" `"$destino`" *$extension /MOV /R:1 /W:1 /TEE /LOG:`"$logPath`""
Write-Host "`n🚚 Ejecutando: $robocopyCmd`n" -ForegroundColor Gray

# Ejecutar y mostrar progreso en vivo
Invoke-Expression $robocopyCmd

Write-Host "`n✅ Movimiento completado. Revisa el log:" -ForegroundColor Green
Write-Host "   $logPath" -ForegroundColor DarkGray
